<%- include('../partials/atas') %>
<div class="kepala">
  <h1>Daftar Produk</h1>
  <div class="aksi">
    <a class="btn" href="/produk/impor">Impor CSV</a>
    <a class="btn" href="/produk/ekspor">Ekspor CSV</a>
    <a class="btn utama" href="/produk/baru">+ Produk</a>
  </div>
</div>
<form class="panel baris" method="get">
  <div style="flex:2"><label>Cari</label><input name="q" value="<%= f.q || '' %>" placeholder="nama, SKU, barcode"></div>
  <div><label>Kategori</label><select name="category_id"><option value="">Semua</option>
    <% kategori.forEach(function (k) { %><option value="<%= k.id %>" <%= String(f.categoryId) === String(k.id) ? 'selected' : '' %>><%= k.name %></option><% }) %></select></div>
  <div><label>Merek</label><select name="brand_id"><option value="">Semua</option>
    <% merek.forEach(function (k) { %><option value="<%= k.id %>" <%= String(f.brandId) === String(k.id) ? 'selected' : '' %>><%= k.name %></option><% }) %></select></div>
  <div><label>Status</label><select name="active"><option value="">Semua</option><option value="1" <%= f.active === '1' ? 'selected' : '' %>>Aktif</option><option value="0" <%= f.active === '0' ? 'selected' : '' %>>Nonaktif</option></select></div>
  <div class="pas"><button class="btn utama">Cari</button></div>
</form>
<div class="tabel-wrap"><table>
  <thead><tr><th></th><th>SKU</th><th>Nama</th><th>Kategori</th><th>Merek</th>
    <% if (lihatHpp) { %><th class="uang">Harga Pokok</th><% } %><th class="uang">Harga Jual</th><th class="qty">Stok</th><th>Status</th></tr></thead>
  <tbody><% rows.forEach(function (p) { %>
    <tr><td><% if (p.photo) { %><img src="/uploads/<%= p.photo %>" alt="" style="width:36px;height:36px;object-fit:cover;border-radius:4px"><% } %></td>
      <td><%= p.sku %></td>
      <td><a href="/produk/<%= p.id %>"><%= p.name %></a><% if (p.variant_name) { %> <span class="lencana"><%= p.variant_name %></span><% } %>
        <% if (p.barcode) { %><div class="kecil redup"><%= p.barcode %></div><% } %></td>
      <td><%= p.category_name || '-' %></td><td><%= p.brand_name || '-' %></td>
      <% if (lihatHpp) { %><td class="uang"><%= rupiah(p.cost_price) %></td><% } %>
      <td class="uang"><%= rupiah(p.sell_price) %></td>
      <td class="qty"><%= angka(p.stok || 0) %> <%= p.unit_name || '' %></td>
      <td><span class="lencana <%= p.active ? 'hijau' : '' %>"><%= p.active ? 'aktif' : 'nonaktif' %></span></td></tr>
  <% }) %><% if (!rows.length) { %><tr><td colspan="9" class="redup">Tidak ada produk.</td></tr><% } %></tbody>
</table></div>
<%- include('../partials/halaman', { total: total, perPage: 50 }) %>
<%- include('../partials/bawah') %>
