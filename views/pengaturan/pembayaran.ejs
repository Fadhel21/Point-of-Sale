<%- include('../partials/atas') %>
<h1>Metode Pembayaran</h1>
<form class="panel baris" method="post" action="/pengaturan/pembayaran">
  <% if (edit) { %><input type="hidden" name="id" value="<%= edit.id %>"><% } %>
  <div><label>Kode</label><input name="code" value="<%= edit ? edit.code : '' %>" <%= edit ? 'readonly' : 'required' %>></div>
  <div><label>Nama</label><input name="name" value="<%= edit ? edit.name : '' %>" required></div>
  <div><label>Jenis</label><select name="kind" <%= edit ? 'disabled' : '' %>><% jenis.forEach(function (j) { %><option value="<%= j %>" <%= edit && edit.kind === j ? 'selected' : '' %>><%= j %></option><% }) %></select>
    <% if (edit) { %><input type="hidden" name="kind" value="<%= edit.kind %>"><% } %></div>
  <div class="pas" style="width:90px"><label>Urutan</label><input name="sort_order" inputmode="numeric" value="<%= edit ? edit.sort_order : '0' %>"></div>
  <div class="pas"><input type="hidden" name="active" value="0"><label class="cek"><input type="checkbox" name="active" value="1" <%= !edit || edit.active ? 'checked' : '' %>> Aktif</label></div>
  <div class="pas"><button class="btn utama"><%= edit ? 'Simpan' : 'Tambah' %></button><% if (edit) { %> <a class="btn" href="/pengaturan/pembayaran">Batal</a><% } %></div>
</form>
<p class="kecil redup">Kode dan jenis tidak bisa diubah setelah dibuat agar laporan lama tetap benar. Nonaktifkan bila tidak dipakai. Jenis "tunai" masuk hitungan kas laci; "piutang" menambah piutang pelanggan.</p>
<table><thead><tr><th>Urutan</th><th>Kode</th><th>Nama</th><th>Jenis</th><th>Status</th><th></th></tr></thead><tbody>
<% rows.forEach(function (m) { %><tr><td><%= m.sort_order %></td><td><%= m.code %></td><td><%= m.name %></td><td><%= m.kind %></td>
  <td><span class="lencana <%= m.active ? 'hijau' : '' %>"><%= m.active ? 'aktif' : 'nonaktif' %></span></td><td><a class="btn kecil" href="?edit=<%= m.id %>">Ubah</a></td></tr><% }) %>
</tbody></table>
<%- include('../partials/bawah') %>
